{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "authorities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "current",
              "candidate",
              "retired"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "state",
          "sha256"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "path"
            ],
            "not": {
              "required": [
                "uri"
              ]
            }
          },
          {
            "required": [
              "uri"
            ],
            "not": {
              "required": [
                "path"
              ]
            }
          }
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "authorities"
  ],
  "additionalProperties": false
}
