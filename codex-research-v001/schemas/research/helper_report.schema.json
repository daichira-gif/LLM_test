{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "pass",
        "blocked",
        "error"
      ]
    },
    "technical_pass": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "PARTIAL",
              "NOT_APPLICABLE",
              "NOT_ASSESSED",
              "NOT_VERIFIED"
            ]
          },
          "details": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "status",
          "details"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "data": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "tool",
    "status",
    "technical_pass",
    "checks",
    "issues",
    "data"
  ],
  "additionalProperties": false
}
