{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "authority": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "additionalProperties": false
    },
    "lineage_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "code": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "python": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "python",
        "platform"
      ],
      "additionalProperties": false
    },
    "inference": {
      "type": "object",
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "top_p": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "seed": {
          "type": "integer"
        },
        "retry": {
          "type": "integer",
          "minimum": 0
        },
        "fallback": {
          "type": "boolean"
        },
        "context_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "request_count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "temperature",
        "top_p",
        "seed",
        "retry",
        "fallback",
        "context_tokens",
        "max_input_tokens",
        "max_output_tokens",
        "request_count"
      ],
      "additionalProperties": false
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "schema_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "path",
          "schema",
          "schema_sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_VERIFIED"
            ]
          },
          "evidence": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "status",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "audit_required_layers": {
      "type": "array",
      "items": {
        "enum": [
          "execution_status",
          "persistence_status",
          "structural_status",
          "semantic_status",
          "scientific_status"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "git_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    }
  },
  "required": [
    "schema_version",
    "authority",
    "lineage_sha256",
    "inputs",
    "code",
    "config",
    "model",
    "runtime",
    "inference",
    "outputs",
    "prerequisites",
    "audit_required_layers"
  ],
  "additionalProperties": false
}
